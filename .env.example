# E-BOLEKA Marketplace Bot v2.0 - Environment Variables
# Copy this file to .env and fill in your actual values

# DeepSeek AI API Key (get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Meta Business Manager System User Access Token (REQUIRED)
# Create a System User in Meta Business Manager, assign it the E-BOLEKA Page
# role (pages_manage_posts, pages_read_engagement), then generate a long-lived
# System User Access Token.
FB_SYSTEM_USER_ACCESS_TOKEN=EAABxxx

# Optional legacy fallback: Facebook Page Access Token
FB_PAGE_ACCESS_TOKEN=EAAxxx

# E-BOLEKA Facebook Page ID
FB_PAGE_ID=123456789

# Unsplash API Access Key (get from https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your-unsplash-key

# Flask Secret Key for session management (generate a random string)
FLASK_SECRET=randomstring123

# Optional: Facebook Graph API version (defaults to v21.0)
GRAPH_API_VERSION=v21.0