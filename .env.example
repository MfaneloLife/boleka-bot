# Boleka SA Marketplace Bot v1.0 - Environment Variables
# Copy this file to .env and fill in your actual values

# DeepSeek AI API Key (get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Facebook Page Access Token (get from Facebook Developer Console)
FB_PAGE_ACCESS_TOKEN=EAAxxx

# Facebook Page ID
FB_PAGE_ID=123456789

# Unsplash API Access Key (get from https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your-unsplash-key

# Flask Secret Key for session management (generate a random string)
FLASK_SECRET=randomstring123

# NOTE: No IG_USERNAME or IG_PASSWORD needed.
# Instagram will auto-sync when you link your FB Page to IG in Meta Account Center.